{
    "name":  "dsh-sidechat",
    "version":  "0.3.1",
    "description":  "Docked right-Sidebar side chat for the DeepSeek Harness 0.2.1 Web GUI: shared session context, selection-marked questions, streaming replies and a Ctrl+J shortcut",
    "license":  "MIT",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./typert":  "./lib/typert.js",
                    "./types":  "./lib/types.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "external":  [

                                            ],
                               "platform":  "web"
                           }
            },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json \u0026\u0026 tsdown",
                    "typecheck":  "tsc -p tsconfig.json --noEmit"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml"
              ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "dependencies":  {
                         "zod":  "^4.4.3"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-llm":  "^0.2.1-rc.2",
                             "@deepseek-ai/dsh-session":  "^0.2.1-rc.2",
                             "@deepseek-ai/dsh-typert-protocol":  "^0.2.1-rc.2",
                             "@deepseek-ai/dsh-typert-registry":  "^0.2.1-rc.2"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.5",
                            "@deepseek-ai/dsh-client-shortcuts":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-layout":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-renderer":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-session":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-sidebar-right":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-slots":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-llm":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-session":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-typert-protocol":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-typert-registry":  "0.2.1-rc.2",
                            "@types/react":  "~18.3.1",
                            "lightningcss":  "^1.33.0",
                            "react":  "^18.3.1",
                            "tsdown":  "^0.22.14",
                            "typescript":  "^5.9.0"
                        },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/JiaskyNo1/dsh-sidechat.git"
                   },
    "homepage":  "https://github.com/JiaskyNo1/dsh-sidechat#readme",
    "bugs":  {
                 "url":  "https://github.com/JiaskyNo1/dsh-sidechat/issues"
             },
    "keywords":  [
                     "deepseek-harness",
                     "dsh-plugin",
                     "side-chat",
                     "chat",
                     "react",
                     "typert"
                 ]
}